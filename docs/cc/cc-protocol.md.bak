    "serverId": { "type": "string", "format": "uuid" },
    "cols": { "type": "integer", "minimum": 1 },
    "rows": { "type": "integer", "minimum": 1 }
  }
}
```

```json
{
  "$id": "https://supercontrolpanel.dev/schemas/cc/commands/stop_server_tunnel.json",
  "type": "object",
