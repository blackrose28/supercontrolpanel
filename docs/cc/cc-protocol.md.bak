    "localPath": { "type": "string" },
    "remotePath": { "type": "string" },
    "recursive": { "type": "boolean", "default": false }
  }
}
```

```json
{
  "$id": "https://supercontrolpanel.dev/schemas/cc/commands/scp_download.json",
  "type": "object",
